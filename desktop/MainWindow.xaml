<Window x:Class="OldYM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OldYM" Height="620" Width="1000" MinHeight="480" MinWidth="780"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource BgTop}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="0,0,18,0" Background="{StaticResource Field}" CornerRadius="8" Padding="12,5" VerticalAlignment="Center">
          <Grid>
            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}"
                     SelectionBrush="{StaticResource Accent}" SelectionOpacity="0.35"
                     FontSize="14" VerticalContentAlignment="Center"
                     KeyDown="OnSearchKey" Panel.ZIndex="1" />
            <TextBlock x:Name="SearchHint" Text="Поиск..." Foreground="{StaticResource Dim}" FontSize="14"
                     VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="0" />

          </Grid>
        </Border>
        <Button Grid.Column="1" x:Name="AccountButton" Content="Аккаунт" Style="{StaticResource Flat}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Side}" Padding="10,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="4,2,0,22" VerticalAlignment="Center">
            <Image Source="/OldYM;component/assets/oldym-about.png" Width="34" Height="34" Stretch="Uniform" Margin="0,0,9,0" />
            <TextBlock Text="OldYM" FontSize="25" FontWeight="Bold" Foreground="{StaticResource Accent}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="МОЯ МУЗЫКА" Foreground="{StaticResource Dim}" FontSize="11" Margin="14,6,0,8" />
          <Button x:Name="NavWave" Content="〜 Моя волна" Style="{StaticResource Nav}" />
          <Button x:Name="NavLikes" Content="♡ Мне нравится" Style="{StaticResource Nav}" />
          <Button x:Name="NavPlaylists" Content="≡ Плейлисты" Style="{StaticResource Nav}" />
          <Button x:Name="NavDownloaded" Content="↓ Скачанное" Style="{StaticResource Nav}" />
          <TextBlock Text="ПРОЧЕЕ" Foreground="{StaticResource Dim}" FontSize="11" Margin="14,18,0,8" />
          <Button x:Name="NavAbout" Content="ⓘ О программе" Style="{StaticResource Nav}" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="18,10,18,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Grid.Row="0" Text="Моя волна" FontSize="24" FontWeight="Bold" Margin="12,0,0,10" />
        <ListBox x:Name="TrackList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="TrackList_MouseDoubleClick">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="34" />
                  <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource Fg}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Artist}" Foreground="{StaticResource Dim}" FontSize="13"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Length}" Foreground="{StaticResource Dim}" FontSize="13"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <Button Grid.Column="3" Tag="{Binding}" Content="{Binding LikeGlyph}" ToolTip="{Binding LikeTip}"
                        Click="LikeTrack_Click" Background="Transparent" BorderThickness="0" Padding="0"
                        FontFamily="Segoe UI Symbol" FontSize="17">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Visibility" Value="Visible" />
                      <Setter Property="Foreground" Value="{StaticResource Dim}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTrack}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsLiked}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Grid.Column="4" Tag="{Binding}" Content="{Binding DownloadGlyph}" ToolTip="{Binding DownloadTip}"
                        Click="DownloadTrack_Click" Background="Transparent" BorderThickness="0" Padding="0"
                        FontFamily="Segoe UI Symbol" FontSize="17">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Visibility" Value="Visible" />
                      <Setter Property="Foreground" Value="{StaticResource Dim}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTrack}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsDownloaded}" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="MoreButton" Grid.Row="2" Content="Показать ещё" Style="{StaticResource Flat}"
                Margin="0,10,0,0" HorizontalAlignment="Center" />
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Player}" Padding="16,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="240" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="6" Background="{StaticResource Field}" Margin="0,0,14,0" ClipToBounds="True">
          <Grid>
            <TextBlock x:Name="CoverGlyph" Text="♪" FontSize="20" Foreground="{StaticResource Dim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed" />
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="PlayerTitle" Text="ничего не играет" FontSize="14" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PlayerArtist" Text="" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Column="2" Margin="18,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
            <Button x:Name="PrevButton" Style="{StaticResource PlayerButton}">
              <Path Data="{StaticResource GeomPrev}" Fill="{StaticResource Fg}" Stretch="Uniform"
                    Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="PlayButton" Style="{StaticResource PlayerButtonPlay}">
              <Path x:Name="PlayIcon" Data="{StaticResource GeomPlay}" Fill="{StaticResource Bg}" Stretch="Uniform"
                    Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource PlayerButton}">
              <Path Data="{StaticResource GeomNext}" Fill="{StaticResource Fg}" Stretch="Uniform"
                    Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="Seek" Minimum="0" Maximum="1000" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                    Style="{StaticResource SeekBar}"
                    PreviewMouseLeftButtonDown="Seek_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="Seek_PreviewMouseLeftButtonUp" />
            <TextBlock Grid.Column="1" x:Name="TimeText" Text="0:00 / 0:00" Foreground="{StaticResource Dim}"
                       FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
          </Grid>
        </Grid>

        <TextBlock Grid.Column="3" x:Name="StatusText" Text="демо-данные" Foreground="{StaticResource Dim}"
                   FontSize="12" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
