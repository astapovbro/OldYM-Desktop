<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="Bg" Color="#121212" />
  <SolidColorBrush x:Key="BgTop" Color="#181818" />
  <SolidColorBrush x:Key="Side" Color="#0E0E0E" />
  <SolidColorBrush x:Key="Field" Color="#242424" />
  <SolidColorBrush x:Key="FieldHover" Color="#333333" />
  <SolidColorBrush x:Key="RowHover" Color="#1D1D1D" />
  <SolidColorBrush x:Key="RowSel" Color="#2A2A2A" />
  <SolidColorBrush x:Key="Fg" Color="#F2F2F2" />
  <SolidColorBrush x:Key="Dim" Color="#8C8C8C" />
  <SolidColorBrush x:Key="Accent" Color="#FFDB4D" />
  <SolidColorBrush x:Key="Player" Color="#181818" />

  <Style x:Key="Flat" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Fg}" />
    <Setter Property="Background" Value="{StaticResource Field}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource FieldHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Nav" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource RowHover}" />
              <Setter Property="Foreground" Value="{StaticResource Fg}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- пиктограммы плеера как в legacy: не символы шрифта, а геометрия -->
  <Geometry x:Key="GeomPlay">M 1,0 L 12,6 L 1,12 Z</Geometry>
  <Geometry x:Key="GeomPause">M 1,0 H 5 V 12 H 1 Z M 7,0 H 11 V 12 H 7 Z</Geometry>
  <Geometry x:Key="GeomPrev">M 0,0 H 3 V 12 H 0 Z M 12,0 L 4,6 L 12,12 Z</Geometry>
  <Geometry x:Key="GeomNext">M 0,0 L 8,6 L 0,12 Z M 9,0 H 12 V 12 H 9 Z</Geometry>

  <Style x:Key="PlayerButton" TargetType="Button">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource FieldHover}" />
              <Setter Property="Foreground" Value="{StaticResource Fg}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlayerButtonPlay" TargetType="Button" BasedOn="{StaticResource PlayerButton}">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="#141416" />
    <Setter Property="Width" Value="50" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="#141416" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Row" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,8">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource RowHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource RowSel}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- бегунок как в legacy: линия 3 px, заливка до маркера, круглый маркер -->
  <SolidColorBrush x:Key="SeekTrack" Color="#3A3A3A" />

  <Style x:Key="SeekRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="3" VerticalAlignment="Center" CornerRadius="2" Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SeekRepeatFill" TargetType="RepeatButton" BasedOn="{StaticResource SeekRepeat}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="3" VerticalAlignment="Center" CornerRadius="2" Background="{StaticResource Accent}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SeekThumb" TargetType="Thumb">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SeekBar" TargetType="Slider">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SmallChange" Value="10" />
    <Setter Property="LargeChange" Value="50" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <Border Height="3" VerticalAlignment="Center" CornerRadius="2" Background="{StaticResource SeekTrack}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource SeekRepeatFill}" Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SeekThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource SeekRepeat}" Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
